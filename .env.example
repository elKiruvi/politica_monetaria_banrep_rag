# Copie este archivo como .env junto a compose.yaml y ajuste los valores.
# Usuario y grupo dueños del catálogo (para que el contenedor pueda leerlo y escribirlo): id -u / id -g
# Con Docker sin root (rootless) use 0 y 0: el UID 0 del contenedor es su propio usuario.
BANREP_UID=1000
BANREP_GID=1000
# Carpeta del catálogo en el equipo (debe existir; se monta en /datos)
BANREP_DATOS=./data/catalogo
# Ollama visto desde el contenedor: del equipo (host.docker.internal) o del perfil «ollama»
BANREP_DOCKER_OLLAMA_URL=http://host.docker.internal:11434
